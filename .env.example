# Neon serverless PostgreSQL connection string
DATABASE_URI=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin for Better Auth (used in cookie and redirect validation)
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob token (from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Google OAuth credentials (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL (used in metadata and og:image)
NEXT_PUBLIC_APP_URL=http://localhost:3000
